# EcoSphere Pulse — environment variables
#
# Copy this file to `.env.local` and fill in the values from:
#   Vercel → Project → Settings → Environment Variables
#
# NEVER commit real values. `.env.local` is gitignored; this `.env.example` holds names only.
# Variable names below are the expected set — VERIFY them against the code on first checkout
# (search the repo for `process.env.` to confirm the exact names actually used).

# ---- Anthropic (AI assistant) ----
ANTHROPIC_API_KEY=

# ---- Supabase (shared with the Dispatch app; project ref: vmocndzlznzfvuedginn) ----
# Service-role key is required to read the secured `sub_directory` view.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Xero (OAuth2: cash, receivables, balance sheet) ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Refresh-token handling: confirm where the token lives (env vs Supabase) in src/lib/xero.ts.
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

# ---- GoHighLevel (GHL) (pipeline / proposals) ----
GHL_API_KEY=
GHL_LOCATION_ID=

# ---- Pulse access gate (the /login password) ----
PULSE_ACCESS_PASSWORD=
